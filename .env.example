DATA_MODE=auto                 # auto | live | synthetic
USDINR_SPOT=88                 # fallback if the FX service is unreachable

# AI analyst: Groq first (free tier), else Anthropic, else rule-based
GROQ_API_KEY=                  # from console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# Database: REQUIRED - Supabase PostgreSQL connection string (Project Settings > Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Auth (turns login on): from Supabase Project Settings > API
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Zerodha Kite Connect (free Personal plan is enough for holdings)
KITE_API_KEY=
KITE_API_SECRET=

# Alerts and schedule
TELEGRAM_BOT_TOKEN=            # from @BotFather -> /newbot
TELEGRAM_CHAT_ID=              # message your bot once, then open https://api.telegram.org/bot<token>/getUpdates
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
SCHEDULER=0                    # 1 on exactly one instance
CORS_ORIGINS=http://localhost:5173
