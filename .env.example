# Database Configuration
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Configuration
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=[JWT_SECRET]

# AI/LLM Configuration (Optional)
GROQ_API_KEY=[GROQ_API_KEY]
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Scheduler Configuration
# Set SCHEDULER=1 on exactly one backend instance for scheduled tasks
SCHEDULER=0

# Optional: Data Configuration
DATA_MODE=auto
USDINR_SPOT=88

# Optional: Alert Configuration
# TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
# TELEGRAM_CHAT_ID=[CHAT_ID]
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL_TO=alerts@your-domain.com

# Optional: Broker Connectors
# KITE_API_KEY=[KITE_KEY]
# KITE_API_SECRET=[KITE_SECRET]
